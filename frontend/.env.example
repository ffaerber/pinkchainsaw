# Pinkchainsaw proxy address. Defaults to the Gnosis Chain deployment when unset.
VITE_CONTRACT_ADDRESS=0x95cBdd7d64040C101240c93fc7B55EC6c2679368

# Chain RPC. Use http://localhost:8545 to run against a local Anvil fork.
VITE_RPC_URL=https://rpc.gnosischain.com

# Public Swarm gateway, used for reads when no local Bee node is reachable.
VITE_BEE_GATEWAY_URL=https://api.gateway.ethswarm.org

# Local Bee node, used for all writes. Also configurable at runtime in the connect modal.
VITE_BEE_API_URL=http://localhost:1633

# Mainnet RPC used only to resolve ENS names for post authors.
VITE_ENS_RPC_URL=https://eth.llamarpc.com
